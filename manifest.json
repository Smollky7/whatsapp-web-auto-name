{
  "manifest_version": 3,
  "name": "Assinatura Automática - WhatsApp Web",
  "version": "1.0.0",
  "description": "Insere automaticamente um identificador no início das mensagens enviadas pelo WhatsApp Web.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage"
  ]
}
